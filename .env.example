# LlamaCloud API Key (Required for LlamaParse and Structured Extraction)
# Get your free API key at: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Optional LLM Providers for RAG answer synthesis
# (If not provided, the built-in local hybrid semantic/extractive engine will be used)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Flask Configuration
SECRET_KEY=llamaparse-secret-key-change-in-production

# Storage Directories
UPLOAD_FOLDER=data/uploads
PARSED_FOLDER=data/parsed
EXTRACTED_FOLDER=data/extracted
INDEX_FOLDER=data/indices

